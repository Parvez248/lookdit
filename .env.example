# Copy to .env.local for local development. Never commit real values.
# Production values live in the Vercel project's environment settings.

# Neon PostgreSQL 18. Pooled URL for the app; unpooled (direct) URL for drizzle-kit migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# HMAC key for IP fingerprints (inquiry rate limit, sign-in throttle). At least 43 characters.
# Generate with: openssl rand -base64 32
INQUIRY_IP_HMAC_SECRET=

# Vercel Blob (case-study images). Set automatically when a Blob store is connected in Vercel;
# for local uploads, copy the store's read-write token here.
BLOB_READ_WRITE_TOKEN=
